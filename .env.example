# ============================================================================
# Painel PNCP — Variáveis de Ambiente (cópia para .env.local e preencha os reais)
# ============================================================================
# Copie este arquivo para `.env.local` na raiz do projeto e troque os
# `SUA_*` / `xxx` pelas credenciais REAIS. NUNCA comite valores reais.

# ---------------------------------------------------------------------------
# SuperBase (autenticação + alertas)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SEU_ANON_KEY
# Chave de SERVIÇO (server-only). Ex.: sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
# Conexão direta ao Postgres (MESMO banco do Supabase). INFORMATIVA/opcional:
# o app usa a API do Supabase (supabase-js/PostgREST), não esta URI diretamente.
# Útil apenas para ferramentas externas (psql, DBeaver, migrations, etc.).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# ---------------------------------------------------------------------------
# E-MAIL — Brevo (https://brevo.com) — PRINCIPAL (transacional: https://app.brevo.com/settings/keys/smtp)
# ---------------------------------------------------------------------------
# 1) Crie uma API key transacional em Brevo (SMTP & API → API Keys).
# 2) Configure um remetente VERIFICADO em Brevo (Sender Identity). O e-mail do
#    remetente pode ser um e-mail verificado por você (no início não exige domínio
#    próprio) — o ideal é um domínio próprio verificado.
# 3) Preencha BREVO_API_KEY e BREVO_FROM_EMAIL (email do remetente verificado).
#    BREVO_FROM_NAME é o nome de exibição (opcional, default "Painel PNCP").
BREVO_API_KEY=xkeysib_SUA_BREVO_API_KEY
BREVO_FROM_EMAIL=on@SEU-DOMINIO.com.br
BREVO_FROM_NAME=Painel PNCP

# ---------------------------------------------------------------------------
# E-MAIL — Resend (https://resend.com) — FALLBACK OPCIONAL
# ---------------------------------------------------------------------------
# Usado apenas se o Brevo não estiver configurado. O app usa o Brevo primeiro.
# 1) Crie uma API Key em resend.com/api-keys
# 2) Verifique um domínio (ou use o domínio sandbox on@resend.dev no começo)
# 3) Preencha RESEND_API_KEY e RESEND_FROM_EMAIL (remetente verificado)
RESEND_API_KEY=re_SUA_RESEND_API_KEY
RESEND_FROM_EMAIL=Alertas <on@SEU-DOMINIO.com.br>

# ---------------------------------------------------------------------------
# TELEGRAM — Bot API (https://core.telegram.org/bots/api)
# ---------------------------------------------------------------------------
# 1) Crie um bot com o @BotFather e copie o TOKEN gerado.
# 2) Configure o token como secret do worker (TELEGRAM_BOT_TOKEN).
#    O destinatário de cada alerta é um chat_id numérico OU um @username.
#    IMPORTANTE: o bot SÓ consegue enviar para chats com os quais já teve
#    contato — o usuário/grupo precisa enviar /start ao bot (ou ser adicionado).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---------------------------------------------------------------------------
# IA — fallback Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# ---------------------------------------------------------------------------
# Usado como FALLBACK quando o Workers AI estiver indisponível/falhar. Opcional:
# a aplicação funciona sem ele, mas sem esta chave o fallback não envia.
GEMINI_API_KEY=SUA_GEMINI_API_KEY

# ---------------------------------------------------------------------------
# CRON dos alertas (Cloudflare Workers / Vinext)
# ---------------------------------------------------------------------------
# O Vinext NÃO suporta handler nativo `scheduled`. O processamento dos alertas
# (envio imediato + lote programado) é feito por um cron EXTERNO que chama, a
# cada minuto, o endpoint protegido:
#
#   GET https://<worker>/api/cron/alertas
#   header: x-cron-secret: <CRON_SECRET>
#
# CRON_SECRET é o token de autorização desse endpoint (configurado como secret
# do worker). Gere um valor aleatório longo, ex.:
#   powershell -Command "$b=New-Object byte[] 32;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);-join ($b|%{$_.ToString('x2')})"
#   npx wrangler secret put CRON_SECRET
CRON_SECRET=SUA_CRON_SECRET_ALEATORIA

# ---------------------------------------------------------------------------
# Ambiente (opcional — NextAuth/Auth.js)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=SUA_SECRET_COM_PELO_MENOS_32_CARACTERES
AUTH_SECRET=SUA_SECRET_COM_PELO_MENOS_32_CARACTERES

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin do painel (página /admin)
# ---------------------------------------------------------------------------
# Senha validada SOMENTE no servidor (nunca no bundle). Em produção, defina
# como secret do worker:
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=SUA_SENHA_ADMIN

# ---------------------------------------------------------------------------
# Cloudflare Workers (PRODUÇÃO) — IMPORTANTE
# ---------------------------------------------------------------------------
# .env/.env.local é usado APENAS em DEV. Em produção (Cloudflare Worker) as
# credenciais são SECRETS do worker, configuradas via:
#
#   npx wrangler secret put BREVO_API_KEY
#   npx wrangler secret put BREVO_FROM_EMAIL
#   npx wrangler secret put BREVO_FROM_NAME
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put RESEND_FROM_EMAIL
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put GEMINI_API_KEY   (fallback de IA, opcional)
#   npx wrangler secret put CRON_SECRET      (token do endpoint /api/cron/alertas)
#
# No Vinext, essas secrets são lidas via `process.env` em runtime (assim como o
# binding do KV/AI, acessado por `import { env } from "cloudflare:workers"`).
# O processamento dos alertas NÃO usa mais um cron nativo: é disparado por um
# cron externo chamando /api/cron/alertas com o CRON_SECRET.
